# --- Auth (GitHub OAuth App → https://github.com/settings/developers) ---
# Callback URL: http://localhost:3000/api/auth/callback/github
#              https://<your-app>.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=Ov23liYourGitHubClientId
AUTH_GITHUB_SECRET=your_github_client_secret
# --- Auth (Discord App → https://discord.com/developers/applications) ---
# OAuth2 → Redirects → Add:
#   http://localhost:3000/api/auth/callback/discord
#   https://<your-app>.vercel.app/api/auth/callback/discord
# Scopes required: identify, email
AUTH_DISCORD_ID=your_discord_client_id
AUTH_DISCORD_SECRET=your_discord_client_secret
# --- TMDB (metadata/search/posters → https://www.themoviedb.org/settings/api) ---
# Read Access Token (v4) or API Key (v3). Server-side only via /api/tmdb/*.
TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=
# --- Trakt OAuth (upstream sync → https://trakt.tv/oauth/applications) ---
# Redirect: http://localhost:3000/api/trakt/callback
#         https://<your-app>.vercel.app/api/trakt/callback
# 2-way sync requires a database (Neon) to store per-user access tokens.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=
# Required in production. Generate with: npx auth secret
AUTH_SECRET=change-me-generate-with-npx-auth-secret

# --- Database (Neon Postgres via Vercel Marketplace — free tier) ---
# Install: Vercel Dashboard → Project → Storage → Neon. This is injected automatically.
# For local dev: vercel env pull .env.local  (or paste the pooled URL here)
# Empty = app falls back to browser localStorage, fully functional without a DB.
DATABASE_URL=

NEXTAUTH_URL=http://localhost:3000
